            "text": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>ログイン - Example Shop</title>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n</head>\n<body>\n<header class=\"site-header\"><a href=\"/\"><img src=\"/static/logo.png\" alt=\"Example Shop\" width=\"120\" height=\"32\"></a></header>\n<main class=\"container\">\n  <h1>ログイン</h1>\n  <form method=\"post\" action=\"/login\" id=\"login-form\" class=\"form\">\n    <input type=\"hidden\" name=\"_token\" value=\"tokA1b2C3d4E5f6G7h8\">\n    <div class=\"field\"><label for=\"username\">ユーザー名</label><input type=\"text\" id=\"username\" name=\"username\" autocomplete=\"username\" required></div>\n    <div class=\"field\"><label for=\"password\">パスワード</label><input type=\"password\" id=\"password\" name=\"password\" autocomplete=\"current-password\" required></div>\n    <button type=\"submit\" class=\"btn btn-primary\">ログイン</button>\n  </form>\n  <p class=\"help\"><a href=\"/password/reset\">パスワードをお忘れですか？</a></p>\n</main>\n<script async src=\"https://www.google-analytics.com/analytics.js\"></script>\n<script>window.ga=window.ga||function(){(ga.q=ga.q||[]).push(arguments)};ga('create','UA-12345-6','auto');ga('send','pageview');</script>\n</body>\n</html>\n"
